# FatoCheck runtime configuration
# Copy to `.env` and adjust as needed. Do not commit secrets.

# Default inference model when the client does not specify one.
# Per-request selection via the API `model` field still overrides this.
MODEL_TYPE=xgboost

# Logging level for the API and CLI entry points (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Uvicorn bind address and port (used by Docker / local run helpers)
API_HOST=0.0.0.0
API_PORT=8000

# Optional override for the trained-models directory.
# Default: <project_root>/models/trained
# MODELS_DIR=/absolute/or/relative/path/to/models/trained
